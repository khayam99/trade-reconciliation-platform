# Dedicated E2E PostgreSQL credentials. Use distinct passwords for these roles.
E2E_PGHOST=127.0.0.1
E2E_PGPORT=5432
E2E_PGDATABASE=ledgerline_e2e
E2E_PGUSER=ledgerline_e2e_app
E2E_PGPASSWORD=replace_with_a_private_runtime_password
E2E_MIGRATION_PGUSER=ledgerline_e2e_migrator
E2E_MIGRATION_PGPASSWORD=replace_with_a_private_migration_password

# Playwright uses fixed local ports: API 3301 and web 5174.
