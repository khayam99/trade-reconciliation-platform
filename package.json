{
  "name": "trade-reconciliation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A synthetic financial operations reconciliation learning project.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev --workspace=@trade-recon/api\" \"npm:dev --workspace=@trade-recon/web\"",
    "build": "npm run build --workspace=@trade-recon/api && npm run build --workspace=@trade-recon/web",
    "typecheck": "npm run typecheck --workspace=@trade-recon/api && npm run typecheck --workspace=@trade-recon/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.mts",
    "test:e2e:config": "node --test scripts/e2e-env.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs up",
    "db:migrate:e2e": "node scripts/e2e-migrate.mjs",
    "db:migrate:down": "node --env-file-if-exists=.env db/migrate.mjs down",
    "db:seed": "node --env-file-if-exists=.env db/seed.mjs",
    "test:db": "node --env-file-if-exists=.env --import tsx --test tests/db/database.integration.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.5"
  }
}
